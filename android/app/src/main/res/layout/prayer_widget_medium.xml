<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Left: active prayer info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_active_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dhuhr"
            android:textColor="#FFE6A8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/cinzel_variable"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_active_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="12:45 PM"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/manrope_variable"
            android:maxLines="1" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="02h 15m"
            android:textColor="#B8D2DAF3"
            android:textSize="11sp"
            android:fontFamily="@font/manrope_variable"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Right: 5-prayer compact list (sunrise hidden) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical|end">

        <LinearLayout
            android:id="@+id/widget_prayer_fajr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_fajr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAJR"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
            <TextView
                android:id="@+id/widget_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="5:31 AM"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_dhuhr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_dhuhr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DHUHR"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
            <TextView
                android:id="@+id/widget_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="12:45 PM"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_asr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_asr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASR"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
            <TextView
                android:id="@+id/widget_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="4:19 PM"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_maghrib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_maghrib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAGHR"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
            <TextView
                android:id="@+id/widget_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="7:04 PM"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_isha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_isha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISHA"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
            <TextView
                android:id="@+id/widget_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="8:23 PM"
                android:textColor="#B8D2DAF3"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_variable" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
