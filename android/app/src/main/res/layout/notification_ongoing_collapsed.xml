<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_active_prayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ISHA"
            android:textColor="#FFE6A8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/cinzel_variable" />

        <TextView
            android:id="@+id/notif_active_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:43 PM"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/manrope_variable" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="04h 51m"
        android:textColor="#FFE6A8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/manrope_variable" />

    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/notif_next_prayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="→ Sabah 4:01 AM"
        android:textColor="#B8D2DAF3"
        android:textSize="11sp"
        android:fontFamily="@font/manrope_variable" />

</LinearLayout>
