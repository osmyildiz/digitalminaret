<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#02030A"
                android:endColor="#071330"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#38FFE6A8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="#33FFE6A8"
                android:centerColor="#10FFE6A8"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
